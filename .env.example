# Postgres
DATABASE_URL="postgresql://sak:sak_password@127.0.0.1:5432/sakmail?schema=public"

# Signs the session cookie. Any long random string; changing it signs everyone out.
SESSION_SECRET="change-me-to-something-long-and-random"

# Where this app is reachable, used to build the inbound webhook URL shown in Setup.
PUBLIC_URL="https://mail.sirapollokaggwaschools.co.ug"

# Outbound mail. The Brevo API key sends over HTTPS, which no host blocks.
BREVO_API_KEY=""
MAIL_FROM_NAME="Sir Apollo Kaggwa Schools"

# First administrator, created by the seed.
SEED_ADMIN_EMAIL="admin@sirapollokaggwaschools.co.ug"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Attachment storage. Set ONE of the two. Without either, mail still arrives and
# reads normally; attachments are recorded by name and shown as not stored.
#
# Cloudinary needs no payment method on its free plan, so start here.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudflare R2 is the better long-term home because reading files back costs
# nothing, but enabling it requires a card on file even on the free tier. Set
# these and they take precedence; anything already stored stays readable.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
