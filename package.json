{
  "name": "sak-mail",
  "version": "0.1.0",
  "private": true,
  "description": "Sir Apollo Kaggwa Schools \u2014 shared school email, delivered into a portal the schools own",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "next": "^15.1.11",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env prisma/seed.mjs"
  }
}
